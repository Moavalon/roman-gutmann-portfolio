---
import type { CollectionEntry } from "astro:content";
import type { Locale, ProjectKey } from "../data/site";
import { copy, projectPath, withBase } from "../data/site";
import ProjectTechnologyVisual from './ProjectTechnologyVisual.astro';
import { jobVerwalterDemo } from '../data/jobVerwalterDemo';

interface Props { project: CollectionEntry<"projects">; locale: Locale; index: number }
const { project, locale, index } = Astro.props;
const t = copy[locale];
const d = project.data;
const demo = jobVerwalterDemo.labels[locale];
const previews = {
  bewerbungsmanager: { src: 'bewerbungsmanager/overview.webp', width: 1600, height: 1400 },
  lagerverwaltung: { src: 'lagerverwaltung/1.webp', width: 1280, height: 900 },
  mymillgame: { src: 'mymillgame/5.webp', width: 650, height: 496 },
  burgenbau: { src: 'burgenbau/5.webp', width: 1280, height: 900 },
};
const preview = d.key === 'internship' ? null : previews[d.key];
const technologies = d.key === 'internship' ? d.stack : d.stack.slice(0, 4);
---

<article class:list={[`project-card accent-${d.accent}`, { 'flagship-card': d.key === 'bewerbungsmanager', 'technology-card': !preview }]}>
  <div class="project-visual" aria-hidden="true">
    <span class="project-index">0{index + 1}</span>
    {preview ? <img src={withBase(`projects/${preview.src}`)} alt="" width={preview.width} height={preview.height} loading="lazy" class="project-preview" /> : <ProjectTechnologyVisual locale={locale} />}
  </div>
  <div class="project-content p-7 sm:p-8">
    {d.key === 'bewerbungsmanager' && <span class="status-badge">{demo.badge}</span>}
    <p class="technology-label">{d.kicker}</p>
    <h3 class="mt-4 text-2xl font-extrabold tracking-tight">{d.title}</h3>
    <p class="mt-4 leading-7 text-muted">{d.excerpt}</p>
    {d.key === 'internship' && <p class="mt-6 text-sm leading-6 text-muted">{t.internshipTechnologyNote}</p>}
    <div class="project-footer">
      <div class="flex flex-wrap gap-2" aria-label={t.technologies}>
        {technologies.map((tech) => <span class="tech-pill">{tech}</span>)}
      </div>
      <div class="project-actions">
        <a href={projectPath(locale, d.key as ProjectKey)} class="project-link inline-flex items-center gap-2 font-extrabold">
          {t.projectLink}<span class="sr-only">: {d.title}</span><span aria-hidden="true">↗</span>
        </a>
        {d.key === 'bewerbungsmanager' && <a href={jobVerwalterDemo.downloadUrl} class="project-link demo-download-link font-extrabold">
          {demo.cardDownload}<span aria-hidden="true">↓</span><span class="sr-only">: JobVerwalter {locale === 'de' ? 'für Windows' : 'for Windows'}</span>
        </a>}
      </div>
    </div>
  </div>
</article>

<style>
  .project-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; margin-top: 1.75rem; }
  .project-actions a { min-height: 2.75rem; }
  .demo-download-link { display: inline-block; padding-block: .6rem; text-decoration: underline; text-decoration-skip-ink: none; text-underline-offset: 4px; }
  .project-content { display: flex; flex-direction: column; min-width: 0; }
  .project-footer { margin-top: auto; padding-top: 1.5rem; }
  .status-badge { align-self: flex-start; margin-bottom: 1.25rem; }
  .project-visual { height: clamp(20rem, 27vw, 23rem); min-height: 0; background: #eaf1ed !important; border-bottom: 1px solid #cbdcd7; }
  .technology-card .project-visual { height: auto; min-height: clamp(20rem, 27vw, 23rem); }
  .project-preview { width: 100%; height: 100%; object-fit: contain; padding: 1.5rem; }
  .project-visual::before { display: none; }
  .project-index { z-index: 1; top: .65rem; left: .65rem; color: #075c57; background: white; padding: .25rem .5rem; border: 1px solid #cbdcd7; border-radius: .4rem; opacity: 1; }
  .flagship-card .project-preview { padding: 0; object-fit: cover; object-position: top left; }
  @media (min-width: 640px) { .flagship-card .project-visual { height: 100%; min-height: 23rem; } }
  @media (min-width: 640px) {
    .project-card:not(.flagship-card) { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; }
    .project-card:not(.flagship-card) .project-visual { height: auto; min-height: clamp(20rem, 27vw, 23rem); }
    .project-card:not(.flagship-card) .project-preview { height: clamp(20rem, 27vw, 23rem); }
  }
</style>
