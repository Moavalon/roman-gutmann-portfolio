---
import { getCollection } from "astro:content";
import ProjectDetail from "../../components/ProjectDetail.astro";
import ApplicationManagerDetail from "../../components/ApplicationManagerDetail.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.locale === "de");
  return projects.map((project) => ({ params: { slug: project.data.routeSlug }, props: { project } }));
}

const { project } = Astro.props;
---
{project.data.key === 'bewerbungsmanager' ? <ApplicationManagerDetail project={project} locale="de" /> : <ProjectDetail project={project} locale="de" />}
