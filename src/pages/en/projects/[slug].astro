---
import { getCollection } from "astro:content";
import ProjectDetail from "../../../components/ProjectDetail.astro";
import ApplicationManagerDetail from "../../../components/ApplicationManagerDetail.astro";
import SteinUndSchuldDetail from '../../../components/SteinUndSchuldDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.locale === "en");
  return projects.map((project) => ({ params: { slug: project.data.routeSlug }, props: { project } }));
}

const { project } = Astro.props;
---
{project.data.key === 'bewerbungsmanager' ? <ApplicationManagerDetail project={project} locale="en" /> : project.data.key === 'stein-und-schuld' ? <SteinUndSchuldDetail locale="en" /> : <ProjectDetail project={project} locale="en" />}
