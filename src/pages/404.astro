---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { homeFor } from "../data/site";
---

<BaseLayout locale="de" title="Seite nicht gefunden | Roman Gutmann" description="Die angeforderte Seite wurde nicht gefunden." alternatePath={homeFor("en")} ogImage={null}>
  <Header locale="de" alternatePath={homeFor("en")} compact />
  <main id="main" class="shell grid min-h-[65vh] place-content-center py-20 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 text-5xl font-extrabold tracking-tight">Diese Seite gibt es nicht.</h1>
    <p class="mt-5 text-lg text-muted">Vielleicht finden Sie auf der Startseite, wonach Sie suchen.</p>
    <a href={homeFor("de")} class="button-primary mx-auto mt-9">Zur Startseite</a>
  </main>
  <Footer locale="de" />
</BaseLayout>
