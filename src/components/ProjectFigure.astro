---
import { withBase } from '../data/site';

interface Props {
  src: string;
  caption: string;
  alt?: string;
  width: number;
  height: number;
  zoom: string;
  eager?: boolean;
}
const { src, caption, alt = caption, width, height, zoom, eager = false } = Astro.props;
const imageUrl = withBase(src);
---
<figure class="project-screenshot">
  <a href={imageUrl} class="project-image-frame" data-project-image aria-label={`${zoom}: ${caption}`} target="_blank" rel="noreferrer">
    <img src={imageUrl} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
    <span class="image-enlarge" aria-hidden="true">{zoom} ↗</span>
  </a>
  <figcaption class="project-image-caption">{caption}</figcaption>
</figure>
