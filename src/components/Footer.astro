---
import type { Locale } from "../data/site";
import { copy, site, homeFor } from "../data/site";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---

<footer class="border-t border-line bg-paper py-8">
  <div class="shell flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} Roman Gutmann · {t.footer}</p>
    <nav aria-label={locale === "de" ? "Links im Fußbereich" : "Footer links"} class="flex flex-wrap justify-center gap-5 font-bold sm:justify-end">
      <a href={`mailto:${site.email}`} class="hover:text-accent-dark">E-Mail</a>
      <a href={site.linkedin} target="_blank" rel="noreferrer" class="hover:text-accent-dark">LinkedIn</a>
      <a href={site.github} target="_blank" rel="noreferrer" class="hover:text-accent-dark">GitHub</a>
      <a href={`${homeFor(locale)}#kontakt`} class="hover:text-accent-dark">{t.nav.contact}</a>
    </nav>
  </div>
</footer>
