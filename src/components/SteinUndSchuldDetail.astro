---
import type { Locale } from '../data/site';
import { copy, homeFor, projectPath, withBase } from '../data/site';
import { steinUndSchuldCopy, steinUndSchuldDemo as demo, steinUndSchuldImage } from '../data/steinUndSchuld';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectLightbox from './ProjectLightbox.astro';
import ProjectFigure from './ProjectFigure.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = steinUndSchuldCopy[locale];
const alternatePath = withBase(locale === 'de' ? 'en/projects/stein-und-schuld/' : 'projekte/stein-und-schuld/');
const home = homeFor(locale);
const hero = steinUndSchuldImage('07-ausgebaute-burg', locale);
---

<BaseLayout locale={locale} title={`${t.title} | Roman Gutmann`} description={t.intro} alternatePath={alternatePath} ogImage={withBase(hero.src)}>
  <Header locale={locale} alternatePath={alternatePath} compact />
  <main id="main" class="project-page project-story">
    <section class="shell project-intro">
      <a class="back-link" href={`${home}#projekte`}>← {copy[locale].back}</a>
      <div class="project-heading">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="detail-title mt-5">{t.title}</h1>
        <p class="mt-6"><span class="status-badge">{t.badge}</span></p>
        <p class="project-lead font-extrabold">{t.slogan}</p>
        <p class="project-lead">{t.intro}</p>
        <nav class="project-jump-links" aria-label={t.navigation}>
          <a class="button-primary" href={demo.downloadUrl}>{t.download} <span aria-hidden="true">↓</span></a>
          <a class="button-secondary" href="#funktionen">{t.functions} ↓</a>
          <a class="button-secondary" href="#entwicklung">{t.process} ↓</a>
        </nav>
        <p class="project-note">{t.downloadNote}</p>
        <div class="project-resource-links">
          <a href={demo.instructionsUrl}>{t.instructions} ↗</a>
          <a href={demo.releaseUrl}>{t.release} ↗</a>
        </div>
      </div>
      <ProjectFigure {...hero} zoom={t.zoom} eager />
      <p class="project-note">{t.screenshotNote}</p>
    </section>

    <section class="shell project-section">
      <div class="project-section-heading">
        <p class="eyebrow">{t.ideaEyebrow}</p>
        <h2 class="section-title">{t.ideaTitle}</h2>
        <p>{t.ideaText}</p>
        <a class="project-link mt-5 inline-flex min-h-11 items-center gap-2 font-extrabold" href={projectPath(locale, 'burgenbau')}>{t.predecessor} ↗</a>
      </div>
    </section>

    <section id="funktionen" class="shell project-section">
      <div class="project-section-heading"><p class="eyebrow">{t.featuresEyebrow}</p><h2 class="section-title">{t.featuresTitle}</h2></div>
      <div class="project-features">
        {t.features.map((feature, index) => <article class:list={['project-feature', { 'project-feature-reverse': index % 2 === 1 }]}>
          <div class="project-feature-copy"><span class="project-step">0{index + 1}</span><h3>{feature.title}</h3><p>{feature.text}</p></div>
          <ProjectFigure {...steinUndSchuldImage(feature.image, locale)} zoom={t.zoom} />
        </article>)}
      </div>
    </section>

    <section id="entwicklung" class="project-process">
      <div class="shell project-section">
        <div class="project-section-heading"><p class="eyebrow">{t.roleEyebrow}</p><h2 class="section-title">{t.roleTitle}</h2><p>{t.roleText}</p></div>
        <div class="project-roles">
          <article><h3>{t.humanTitle}</h3><p class="project-role-label">{t.humanRole}</p><p>{t.humanText}</p></article>
          <article><h3>{t.agentTitle}</h3><p class="project-role-label">{t.agentRole}</p><p>{t.agentText}</p></article>
        </div>
        <div class="project-jira"><p class="eyebrow">Jira</p><h3>{t.jiraTitle}</h3><p>{t.jiraText}</p></div>
        <p class="project-learning">{t.learning}</p>
      </div>
    </section>

    <section class="shell project-section">
      <div class="project-section-heading"><p class="eyebrow">{t.technologyEyebrow}</p><h2 class="section-title">{t.technologyTitle}</h2><p>{t.technologyText}</p></div>
      <ul class="project-stack" aria-label={copy[locale].technologies}>{['Godot', 'GDScript', 'Jira', 'OpenAI Codex'].map(tech => <li class="tech-pill">{tech}</li>)}</ul>
      <a class="project-link mt-6 inline-flex min-h-11 items-center font-extrabold" href={demo.repositoryUrl}>{t.repository} ↗</a>
    </section>

    <section class="shell project-section project-status">
      <div class="project-section-heading"><p class="eyebrow">{t.statusEyebrow}</p><h2 class="section-title">{t.statusTitle}</h2><p>{t.statusText}</p></div>
      <div class="project-status-grid">
        <div><h3>{t.available}</h3><ul>{t.availableItems.map(item => <li>{item}</li>)}</ul></div>
        <div><h3>{t.planned}</h3><p class="mt-4 leading-8 text-muted">{t.plannedText}</p></div>
      </div>
    </section>

    <section class="shell project-contact-wrap"><div class="contact-panel"><p class="eyebrow text-white/70">{copy[locale].contactEyebrow}</p><h2 class="project-contact-title section-title">{t.contactTitle}</h2><p class="project-contact-text">{t.contactText}</p><a class="button-inverted mt-8" href={`${home}#kontakt`}>{t.contactCta} →</a></div></section>
  </main>
  <ProjectLightbox locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
