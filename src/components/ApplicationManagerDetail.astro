---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';
import { copy, homeFor, projectPath } from '../data/site';
import { applicationManagerCopy } from '../data/applicationManager';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectScreenshot from './ProjectScreenshot.astro';
import ProjectLightbox from './ProjectLightbox.astro';
interface Props { project: CollectionEntry<'projects'>; locale: Locale; }
const { project, locale } = Astro.props;
const t = applicationManagerCopy[locale];
const alternatePath = projectPath(locale === 'de' ? 'en' : 'de', 'bewerbungsmanager');
const home = homeFor(locale);
---
<BaseLayout locale={locale} title={`${project.data.title} | Roman Gutmann`} description={project.data.excerpt} alternatePath={alternatePath}>
  <Header locale={locale} alternatePath={alternatePath} compact />
  <main id="main" class="project-page application-story">
    <section class="shell project-intro">
      <a class="back-link" href={`${home}#projekte`}>← {copy[locale].back}</a>
      <div class="project-heading">
        <p class="eyebrow">{t.eyebrow}</p>
        <p class="product-name">{project.data.title} <span class="status-badge">{t.badge}</span></p>
        <h1 class="detail-title">{t.title}</h1>
        <p class="project-lead">{t.intro}</p>
        <nav class="jump-links" aria-label={locale === 'de' ? 'Projektabschnitte' : 'Project sections'}>
          <a class="button-primary" href="#funktionen">{t.functions} ↓</a>
          <a class="button-secondary" href="#entwicklung">{t.process} ↓</a>
        </nav>
      </div>
      <ProjectScreenshot image="overview" caption={t.overviewCaption} zoom={t.zoom} eager />
      <p class="demo-note">{t.demo}</p>
    </section>

    <section class="shell project-section">
      <div class="project-section-heading"><p class="eyebrow">{t.benefitEyebrow}</p><h2 class="section-title">{t.benefitTitle}</h2><p>{t.benefitText}</p></div>
      <div class="benefits">{t.benefits.map(([title, text], index) => <div><span class="project-step">0{index + 1}</span><h3>{title}</h3><p>{text}</p></div>)}</div>
    </section>

    <section id="funktionen" class="shell project-section">
      <div class="project-section-heading"><p class="eyebrow">{t.featuresEyebrow}</p><h2 class="section-title">{t.featuresTitle}</h2></div>
      <div class="features">{t.features.map((feature, index) => <article class:list={['feature', { reverse: index % 2 === 1 }]}>
        <div class="feature-copy"><span class="project-step">0{index + 1}</span><h3>{feature.title}</h3><p>{feature.text}</p></div>
        <ProjectScreenshot image={feature.image} caption={feature.caption} zoom={t.zoom} />
      </article>)}</div>
    </section>

    <section id="entwicklung" class="process-section">
      <div class="shell project-section">
        <div class="project-section-heading"><p class="eyebrow">{t.roleEyebrow}</p><h2 class="section-title">{t.roleTitle}</h2><p>{t.roleText}</p></div>
        <div class="roles">
          <article><h3>{t.humanTitle}</h3><p class="role-label">{t.humanRole}</p><p>{t.humanText}</p></article>
          <article><h3>{t.agentTitle}</h3><p class="role-label">{t.agentRole}</p><p>{t.agentText}</p></article>
        </div>
        <p class="learning">{t.learning}</p>
        <div class="feature jira-feature"><div class="feature-copy"><p class="eyebrow">Jira</p><h3>{t.jiraTitle}</h3><p>{t.jiraText}</p></div><ProjectScreenshot image="jira" caption={t.jiraCaption} zoom={t.zoom} /></div>
      </div>
    </section>

    <section class="shell project-section">
      <div class="project-section-heading"><p class="eyebrow">{t.qualityEyebrow}</p><h2 class="section-title">{t.qualityTitle}</h2></div>
      <div class="quality-grid">{t.quality.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div>
      <article class="docker-block"><h3>{t.dockerTitle}</h3><p>{t.dockerText}</p><ul class="services" aria-label="Docker Compose"><li>Web</li><li>API</li><li>Worker</li><li>PostgreSQL</li></ul></article>
      <ul class="stack" aria-label={copy[locale].technologies}>{['C# · ASP.NET Core', 'React · TypeScript', 'PostgreSQL · EF Core', 'Docker', 'GitHub Actions', 'Jira', 'OpenAI Codex'].map(tech => <li class="tech-pill">{tech}</li>)}</ul>
    </section>

    <section class="shell project-section status-section">
      <div class="project-section-heading"><span class="status-badge">{t.badge}</span><p class="eyebrow">{t.statusEyebrow}</p><h2 class="section-title">{t.statusTitle}</h2><p>{t.statusText}</p></div>
      <div class="status-grid"><div><h3>{t.available}</h3><ul>{t.availableItems.map(item => <li>{item}</li>)}</ul></div><div><h3>{t.planned}</h3><ul>{t.plannedItems.map(item => <li>{item}</li>)}</ul></div></div>
      <p class="demo-note">{t.roadmapNote}</p>
    </section>

    <section class="shell project-contact-wrap"><div class="contact-panel"><p class="eyebrow text-white/70">{copy[locale].contactEyebrow}</p><h2 class="project-contact-title section-title">{t.contactTitle}</h2><p class="project-contact-text">{t.contactText}</p><a class="button-inverted mt-8" href={`${home}#kontakt`}>{t.contactCta} →</a></div></section>
  </main>
  <ProjectLightbox locale={locale} />
  <Footer locale={locale} />
</BaseLayout>
<style>
  p { line-height: 1.85; }
  .product-name { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 1rem; margin: 1.25rem 0; font-weight: 800; font-size: 1.15rem; }
  .jump-links { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: .8rem; margin-top: 2rem; }
  .jump-links a { white-space: normal; text-align: center; }
  .demo-note { color: var(--color-muted); font-size: .875rem; margin-top: 1rem; }
  .benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .benefits > div { border-top: 1px solid var(--color-line); padding-top: 1.5rem; }
  .benefits p, .feature-copy p, .roles p, .quality-grid p { color: var(--color-muted); margin-top: 1rem; }
  .features { display: grid; gap: clamp(3.5rem, 7vw, 6.5rem); }
  .feature { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .feature-copy h3 { font-size: clamp(1.7rem, 2.6vw, 2.35rem); }
  .reverse { grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); }
  .reverse .feature-copy { order: 2; }
  .process-section { background: color-mix(in srgb, var(--color-accent) 8%, var(--color-paper)); border-block: 1px solid var(--color-line); }
  .roles, .quality-grid, .status-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .roles article { background: var(--color-paper); border: 1px solid var(--color-line); padding: clamp(1.3rem, 3vw, 2.5rem); border-radius: 1rem; }
  .roles .role-label { font-weight: 800; color: var(--color-accent-dark); }
  .learning { max-width: 49rem; margin: 2.5rem 0 4rem; }
  .quality-grid article { padding: 1.5rem 0; border-top: 1px solid var(--color-line); }
  .docker-block { margin-top: 2rem; padding: 2rem; border: 1px solid var(--color-line); border-radius: 1rem; background: var(--color-paper); }
  .docker-block p { color: var(--color-muted); margin-top: 1rem; }
  .services { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; list-style: none; padding: 0; }
  .services li { padding: .65rem 1.1rem; background: var(--color-canvas); border: 1px solid var(--color-line); border-radius: .5rem; font-weight: 800; color: var(--color-accent-dark); }
  .stack { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: .6rem; margin-top: 2.5rem; list-style: none; padding: 0; }
  .status-section { border-top: 1px solid var(--color-line); }
  .status-section .eyebrow { margin-top: 1.5rem; }
  .status-grid { max-width: 60rem; }
  .status-grid ul { padding-left: 1.25rem; margin-top: 1rem; color: var(--color-muted); list-style: disc; }
  .status-grid li { line-height: 1.8; margin-top: .7rem; padding-left: .3rem; }
  .status-section > .demo-note { max-width: 60rem; margin: 2rem 0 0; }
  @media (max-width: 760px) {
    .benefits, .roles, .quality-grid, .status-grid, .feature, .reverse { grid-template-columns: minmax(0, 1fr); }
    .reverse .feature-copy { order: 0; }
    .benefits { gap: 1.5rem; }
  }
</style>
