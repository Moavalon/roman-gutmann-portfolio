---
import type { CollectionEntry } from "astro:content";
import type { Locale, ProjectKey } from "../data/site";
import { copy, homeFor, projectPath, withBase } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ProjectGallery from './ProjectGallery.astro';
import { projectScreenshots } from '../data/projectScreenshots';
import ProjectTechnologyVisual from './ProjectTechnologyVisual.astro';
import ProjectLightbox from './ProjectLightbox.astro';

interface Props { project: CollectionEntry<"projects">; locale: Locale }
const { project, locale } = Astro.props;
const d = project.data;
const t = copy[locale];
const otherLocale: Locale = locale === "de" ? "en" : "de";
const alternatePath = projectPath(otherLocale, d.key as ProjectKey);
const home = homeFor(locale);
const ogImage = d.key === "burgenbau" ? withBase("projects/burgenbau.jpg") : null;
const screenshots = projectScreenshots(d.key, locale);
---

<BaseLayout
  locale={locale}
  title={`${d.title} | Roman Gutmann`}
  description={d.excerpt}
  alternatePath={alternatePath}
  ogImage={ogImage}
>
  <Header locale={locale} alternatePath={alternatePath} compact />
  <main id="main" class="compact-project">
    <section class="detail-hero">
      <div class="shell project-intro">
        <a href={`${home}#projekte`} class="back-link"><span aria-hidden="true">←</span> {t.back}</a>
        <div>
          <div class="project-heading">
            <p class="eyebrow">{d.kicker}</p>
            <h1 class="detail-title mt-5 font-extrabold">{d.title}</h1>
            <p class="project-lead">{d.excerpt}</p>
          </div>
          <div class="project-media">{screenshots.length > 0 ? <ProjectGallery title={d.title} locale={locale} screenshots={screenshots} /> : <div class="technology-panel"><ProjectTechnologyVisual locale={locale} /></div>}</div>
        </div>
      </div>
    </section>

    <section class="section shell">
      <div class="detail-grid">
        <div>
          <h2 class="project-subheading">{t.context}</h2>
          <p class="mt-5 text-lg leading-8">{d.context}</p>
        </div>
        <div>
          <h2 class="project-subheading">{t.role}</h2>
          <p class="mt-5 text-lg leading-8">{d.role}</p>
        </div>
      </div>

      <div class="detail-block mt-16">
        <h2 class="project-section-heading">{t.contributions}</h2>
        <ul class="contribution-list mt-8">
          {d.contributions.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>
          ))}
        </ul>
      </div>

      <div class="mt-16 grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
        <div class="detail-block">
          <h2 class="project-subheading">{t.technologies}</h2>
          {d.key === 'internship' && <p class="mt-5 leading-7 text-muted">{t.internshipTechnologyNote}</p>}
          <div class="mt-7 flex flex-wrap gap-2">
            {d.stack.map((tech) => <span class="tech-pill bg-white">{tech}</span>)}
          </div>
        </div>
        <div class="detail-block">
          <h2 class="project-subheading">{t.learnings}</h2>
          <ul class="mt-6 space-y-4">
            {d.learnings.map((item) => <li class="flex gap-3 leading-7"><span class="text-accent" aria-hidden="true">✓</span>{item}</li>)}
          </ul>
        </div>
      </div>

      {(d.repository || d.demo) && (
        <div class="mt-14 flex flex-wrap gap-4">
          {d.repository && <a href={d.repository} target="_blank" rel="noreferrer" class="button-primary">{t.sourceCode} ↗</a>}
          {d.demo && <a href={d.demo} target="_blank" rel="noreferrer" class="button-secondary">{t.liveDemo} ↗</a>}
        </div>
      )}
    </section>

    <section class="shell pb-24">
      <a href={`${home}#kontakt`} class="contact-panel block">
        <p class="eyebrow text-white/70">{t.contactEyebrow}</p>
        <h2 class="mt-4 max-w-3xl text-3xl font-extrabold text-white sm:text-4xl">{t.contactTitle}</h2>
        <span class="mt-8 inline-flex rounded-full bg-white px-5 py-3 font-extrabold text-accent-dark">{t.emailCta} →</span>
      </a>
    </section>
  </main>
  {screenshots.length > 0 && <ProjectLightbox locale={locale} />}
  <Footer locale={locale} />
</BaseLayout>
<style>
  .compact-project { overflow-wrap: anywhere; }
  .project-intro { padding-top: 3rem; }
  .project-heading { max-width: 58rem; margin: clamp(3rem, 7vw, 6rem) auto 3rem; text-align: center; }
  .detail-title { font-size: clamp(2.35rem, 5.7vw, 5rem); line-height: 1.08; letter-spacing: -.05em; }
  .project-lead { max-width: 49rem; margin: 1.75rem auto 0; font-size: clamp(1.05rem, 1.7vw, 1.3rem); line-height: 1.85; color: var(--color-muted); }
  .project-media { max-width: 64rem; margin-inline: auto; }
  .technology-panel { max-width: 49rem; margin: auto; overflow: hidden; border: 1px solid #cbdcd7; border-radius: 1rem; }
  .project-subheading { font-size: 1.35rem; font-weight: 800; line-height: 1.35; letter-spacing: -.02em; text-wrap: balance; }
  .project-section-heading { font-size: clamp(1.9rem, 3.5vw, 3.2rem); line-height: 1.16; letter-spacing: -.035em; font-weight: 800; text-align: center; text-wrap: balance; }
  .detail-grid { gap: 2rem; background: transparent; border: 0; border-radius: 0; }
  .detail-grid > div { border: 1px solid #cbdcd7; border-radius: 1rem; }
  .detail-block { border-radius: 1rem; }
  .contribution-list li { grid-template-columns: 2rem minmax(0, 1fr); }
  .contribution-list li span { font-size: .875rem; }
  @media (max-width: 760px) { .project-intro { padding-top: 2rem; } .detail-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
