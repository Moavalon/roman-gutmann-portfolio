---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { site, withBase, type Locale } from "../data/site";
import { legal } from "../data/legal";
interface Props { locale: Locale; kind: "notice" | "privacy" }
const { locale, kind } = Astro.props;
const page = legal[locale][kind];
const alternatePath = withBase(locale === "de" ? `en/${kind === "notice" ? "legal-notice" : "privacy"}/` : `${kind === "notice" ? "impressum" : "datenschutz"}/`);
---
<BaseLayout locale={locale} title={`${page.title} | Roman Gutmann`} description={page.description} alternatePath={alternatePath}>
  <Header locale={locale} alternatePath={alternatePath} compact />
  <main id="main" class="shell legal-page">
    <p class="eyebrow">{locale === "de" ? "Rechtliche Informationen" : "Legal information"}</p>
    <h1>{page.title}</h1>
    <p class="updated">{locale === "de" ? "Stand: 12. September 2026" : "Last updated: 12 September 2026"}</p>
    {page.sections.map(section => <section>
      <h2>{section.title}</h2>
      {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      {"links" in section && section.links && <ul>{section.links.map(link => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
    </section>)}
    <section><h2>{locale === "de" ? "Kontakt" : "Contact"}</h2><p><a href={`mailto:${site.email}`}>{site.email}</a></p></section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
<style>
  .legal-page { padding-block: clamp(3rem, 7vw, 6rem); }
  h1, h2 { font-weight: 800; }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.15; overflow-wrap: anywhere; margin-block: 1rem; }
  h2 { font-size: 1.4rem; line-height: 1.4; margin-bottom: 1rem; }
  section { margin-top: 2.5rem; }
  section p, li, .updated { line-height: 1.8; color: var(--color-muted); }
  section p + p { margin-top: 1rem; }
  a { text-decoration: underline; text-underline-offset: .2em; overflow-wrap: anywhere; }
  ul { margin-top: 1rem; padding-left: 1.3rem; list-style: disc; }
  .updated { font-size: .95rem; }
</style>
